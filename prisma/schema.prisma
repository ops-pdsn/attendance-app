generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String?
  avatar        String?
  role          String   @default("employee") // admin, hr, manager, employee
  department    String?
  employeeId    String?  @unique
  phone         String?
  isActive      Boolean  @default(true)
  dateOfBirth   DateTime?

  // Manager hierarchy
  managerId     String?
  manager       User?    @relation("UserManager", fields: [managerId], references: [id])
  subordinates  User[]   @relation("UserManager")

  // Payroll: Earnings
  basicSalary        Float?
  hra                Float?
  da                 Float?
  conveyance         Float?
  medicalAllowance   Float?
  specialAllowance   Float?
  otherAllowances    Float?

  // Payroll: Deductions
  pf                 Float?
  esi                Float?
  professionalTax    Float?
  tds                Float?
  otherDeductions    Float?

  // Bank Details
  bankAccountNumber  String?
  bankName           String?
  ifscCode           String?
  bankBranch         String?

  // Tax & Compliance
  panNumber          String?
  uanNumber          String?
  esiNumber          String?

  // Employment Details
  dateOfJoining      DateTime?
  dateOfLeaving      DateTime?
  employmentType     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Core relations
  userShifts      UserShift[]
  tasks           Task[]         @relation("TaskOwner")
  assignedTasks   Task[]         @relation("TaskAssignee")
  attendance      Attendance[]
  leaveBalances   LeaveBalance[]
  leaveRequests   LeaveRequest[] @relation("LeaveRequester")
  leaveApprovals  LeaveRequest[] @relation("LeaveApprover")
  notifications   Notification[]
  permissions     Permission[]

  // Feature 1: Regularization
  regularizationRequests AttendanceRegularization[] @relation("RegularizationRequests")
  regularizationReviews  AttendanceRegularization[] @relation("RegularizationReviews")

  // Feature 2: Overtime & Comp-off
  overtimeRequests  OvertimeRequest[] @relation("OvertimeRequests")
  overtimeApprovals OvertimeRequest[] @relation("OvertimeApprovals")
  compOffBalance    CompOffBalance[]

  // Feature 7: Announcements
  announcements Announcement[]

  // Feature 9: Birthday — dateOfBirth field added above

  // Feature 10: Shift Swap
  shiftSwapsMade     ShiftSwapRequest[] @relation("SwapRequester")
  shiftSwapsReceived ShiftSwapRequest[] @relation("SwapTarget")
  shiftSwapApprovals ShiftSwapRequest[] @relation("SwapApprover")

  // Feature 11: Leave Encashment
  leaveEncashments    LeaveEncashment[] @relation("EncashmentUser")
  encashmentApprovals LeaveEncashment[] @relation("EncashmentApprover")

  // Feature 13: Documents
  documents         Document[] @relation("UserDocuments")
  uploadedDocuments Document[] @relation("DocumentUploader")

  // Feature 14: Audit Logs
  auditLogs AuditLog[]

  @@index([email])
  @@index([managerId])
}

model Task {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  type      String
  priority  String   @default("medium")
  completed Boolean  @default(false)
  notes     String?

  // Feature 3: Task assignment
  assignedToId String?
  assignedTo   User?    @relation("TaskAssignee", fields: [assignedToId], references: [id])

  // Category & Sub-category
  categoryId    String?
  category      TaskCategory?    @relation(fields: [categoryId], references: [id])
  subCategoryId String?
  subCategory   TaskSubCategory? @relation(fields: [subCategoryId], references: [id])

  userId    String
  user      User     @relation("TaskOwner", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([assignedToId])
  @@index([date])
  @@index([priority])
  @@index([categoryId])
}

model TaskCategory {
  id            String            @id @default(cuid())
  name          String            @unique
  description   String?
  color         String            @default("#3b82f6")
  isActive      Boolean           @default(true)
  subCategories TaskSubCategory[]
  tasks         Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model TaskSubCategory {
  id         String       @id @default(cuid())
  name       String
  categoryId String
  category   TaskCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isActive   Boolean      @default(true)
  tasks      Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, categoryId])
  @@index([categoryId])
}

model Attendance {
  id        String    @id @default(cuid())
  date      DateTime
  status    String
  session   String    @default("full_day")
  punchIn   DateTime?
  punchOut  DateTime?
  notes     String?
  location  String?
  latitude  Float?
  longitude Float?
  photo     String?   @db.Text

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([date, session, userId])
  @@index([userId])
  @@index([date])
}

model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime @unique
  type        String   @default("public")
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("#3b82f6")
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model LeaveType {
  id               String   @id @default(cuid())
  name             String   @unique
  code             String   @unique
  description      String?
  color            String   @default("#3b82f6")
  defaultDays      Int      @default(0)
  carryForward     Boolean  @default(false)
  maxCarryForward  Int      @default(0)
  requiresApproval Boolean  @default(true)
  isActive         Boolean  @default(true)
  isPaid           Boolean  @default(true)
  isEncashable     Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
  leaveEncashments LeaveEncashment[]

  @@index([code])
}

model LeaveBalance {
  id           String    @id @default(cuid())
  year         Int
  total        Float     @default(0)
  used         Float     @default(0)
  pending      Float     @default(0)
  carryForward Float     @default(0)

  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  leaveTypeId  String
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, leaveTypeId, year])
  @@index([userId])
  @@index([year])
}

model LeaveRequest {
  id               String    @id @default(cuid())
  startDate        DateTime
  endDate          DateTime
  days             Float
  reason           String?
  status           String    @default("pending")
  type             String    @default("full")
  emergencyContact String?

  approvedBy       String?
  approver         User?     @relation("LeaveApprover", fields: [approvedBy], references: [id])
  approvedAt       DateTime?
  rejectionReason  String?

  userId           String
  user             User      @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)

  leaveTypeId      String
  leaveType        LeaveType @relation(fields: [leaveTypeId], references: [id])

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([startDate, endDate])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  link      String?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model Shift {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  startTime     String
  endTime       String
  breakMinutes  Int      @default(60)
  graceMinutes  Int      @default(15)
  color         String   @default("#3b82f6")
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userShifts         UserShift[]
  swapRequestsOffered  ShiftSwapRequest[] @relation("SwapRequesterShift")
  swapRequestsReceived ShiftSwapRequest[] @relation("SwapTargetShift")
}

model UserShift {
  id        String   @id @default(cuid())
  userId    String
  shiftId   String
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shiftId])
}

model Permission {
  id        String   @id @default(cuid())
  userId    String
  module    String   // attendance, tasks, leave, payroll, etc.

  canRead   Boolean  @default(false)
  canWrite  Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, module])
  @@index([userId])
}

// ─── Feature 1: Attendance Regularization ────────────────────────────────────
model AttendanceRegularization {
  id                String    @id @default(cuid())
  date              DateTime
  reason            String
  requestedStatus   String
  requestedPunchIn  DateTime?
  requestedPunchOut DateTime?
  requestedSession  String?
  status            String    @default("pending") // pending, approved, rejected
  rejectionReason   String?

  userId     String
  user       User   @relation("RegularizationRequests", fields: [userId], references: [id], onDelete: Cascade)

  reviewedBy  String?
  reviewer    User?     @relation("RegularizationReviews", fields: [reviewedBy], references: [id])
  reviewedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([date])
}

// ─── Feature 2: Overtime & Comp-off ──────────────────────────────────────────
model OvertimeRequest {
  id              String    @id @default(cuid())
  date            DateTime
  hours           Float
  reason          String
  status          String    @default("pending") // pending, approved, rejected
  compOffGranted  Boolean   @default(false)
  rejectionReason String?

  userId     String
  user       User   @relation("OvertimeRequests", fields: [userId], references: [id], onDelete: Cascade)

  approvedBy  String?
  approver    User?     @relation("OvertimeApprovals", fields: [approvedBy], references: [id])
  approvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([date])
}

model CompOffBalance {
  id     String @id @default(cuid())
  year   Int
  earned Float  @default(0)
  used   Float  @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year])
  @@index([userId])
}

// ─── ESSL Biometric Integration ──────────────────────────────────────────────
model EsslMachine {
  id             String    @id @default(cuid())
  serialNo       String    @unique
  name           String?
  location       String?
  ipAddress      String?
  port           Int       @default(4370)
  devicePassword String?   @default("0")
  isActive       Boolean   @default(true)
  lastSyncAt     DateTime?
  totalPunches   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  logs           EsslLog[]

  @@index([serialNo])
}

model EsslLog {
  id           String       @id @default(cuid())
  machineId    String?
  machine      EsslMachine? @relation(fields: [machineId], references: [id])
  employeeId   String
  punchTime    DateTime
  punchType    Int          @default(0)    // 0=IN 1=OUT 2=break-out 3=break-in
  verifyMode   Int?                        // 1=Fingerprint 2=Face 3=Card 0=Password
  source       String       @default("adms")  // adms | csv | zkteco
  rawData      String?
  processed    Boolean      @default(false)
  processedAt  DateTime?
  userId       String?
  attendanceId String?
  createdAt    DateTime     @default(now())

  @@index([employeeId])
  @@index([punchTime])
  @@index([processed])
  @@index([machineId])
}

// ─── Feature 7: Announcements ────────────────────────────────────────────────
model Announcement {
  id         String    @id @default(cuid())
  title      String
  content    String
  type       String    @default("info") // info, warning, urgent, event
  targetRole String    @default("all")  // all, employee, manager, hr, admin
  isPinned   Boolean   @default(false)
  expiresAt  DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([type])
  @@index([targetRole])
}

// ─── Feature 10: Shift Swap Requests ─────────────────────────────────────────
model ShiftSwapRequest {
  id     String   @id @default(cuid())
  date   DateTime
  reason String?
  status String   @default("pending") // pending, accepted, rejected, manager_approved

  requesterId      String
  requester        User  @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  targetUserId     String
  targetUser       User  @relation("SwapTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  requesterShiftId String
  requesterShift   Shift @relation("SwapRequesterShift", fields: [requesterShiftId], references: [id])

  targetShiftId    String
  targetShift      Shift @relation("SwapTargetShift", fields: [targetShiftId], references: [id])

  approvedBy  String?
  approver    User?     @relation("SwapApprover", fields: [approvedBy], references: [id])
  approvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId])
  @@index([targetUserId])
  @@index([status])
}

// ─── Feature 11: Leave Encashment ────────────────────────────────────────────
model LeaveEncashment {
  id          String    @id @default(cuid())
  year        Int
  days        Float
  amount      Float?
  status      String    @default("pending") // pending, approved, rejected, processed
  reason      String?
  rejectionReason String?

  userId      String
  user        User      @relation("EncashmentUser", fields: [userId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  approvedBy  String?
  approver    User?     @relation("EncashmentApprover", fields: [approvedBy], references: [id])
  approvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ─── Feature 13: Documents ───────────────────────────────────────────────────
model Document {
  id       String  @id @default(cuid())
  name     String
  type     String  // offer_letter, id_proof, contract, certificate, other
  url      String
  size     Int?
  mimeType String?

  userId     String
  user       User   @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)

  uploadedBy String
  uploader   User   @relation("DocumentUploader", fields: [uploadedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
}

// ─── Feature 14: Audit Logs ──────────────────────────────────────────────────
model AuditLog {
  id         String  @id @default(cuid())
  action     String  // create, update, delete, approve, reject, login
  module     String  // user, attendance, leave, task, payroll, shift, permission
  entityId   String?
  entityType String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
}
